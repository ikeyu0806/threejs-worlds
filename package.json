{
  "name": "threejs-worlds",
  "version": "1.0.0",
  "description": "A collection of independent Three.js worlds",
  "private": true,
  "type": "module",
  "workspaces": ["worlds/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test scripts/worlds.test.mjs scripts/aquarium-assets.test.mjs",
    "dev:entrance": "npm run dev --workspace=@threejs-worlds/entrance --",
    "dev:aquarium": "npm run dev --workspace=@threejs-worlds/aquarium --",
    "dev:cyberpunk": "npm run dev --workspace=@threejs-worlds/cyberpunk --",
    "dev:cosmos": "npm run dev --workspace=@threejs-worlds/cosmos --",
    "dev:heian": "npm run dev --workspace=@threejs-worlds/heian --",
    "dev:shibuya": "npm run dev --workspace=@threejs-worlds/shibuya --",
    "dev:akihabara": "npm run dev --workspace=@threejs-worlds/akihabara --",
    "dev:shinjuku": "npm run dev --workspace=@threejs-worlds/shinjuku --",
    "build": "npm run build --workspaces && node scripts/assemble.mjs",
    "build:entrance": "npm run build --workspace=@threejs-worlds/entrance --",
    "build:aquarium": "npm run build --workspace=@threejs-worlds/aquarium --",
    "build:cyberpunk": "npm run build --workspace=@threejs-worlds/cyberpunk --",
    "build:cosmos": "npm run build --workspace=@threejs-worlds/cosmos --",
    "build:heian": "npm run build --workspace=@threejs-worlds/heian --",
    "build:shibuya": "npm run build --workspace=@threejs-worlds/shibuya --",
    "build:akihabara": "npm run build --workspace=@threejs-worlds/akihabara --",
    "build:shinjuku": "npm run build --workspace=@threejs-worlds/shinjuku --",
    "preview": "node scripts/preview.mjs",
    "preview:entrance": "npm run preview --workspace=@threejs-worlds/entrance --",
    "preview:aquarium": "npm run preview --workspace=@threejs-worlds/aquarium --",
    "preview:cyberpunk": "npm run preview --workspace=@threejs-worlds/cyberpunk --",
    "preview:cosmos": "npm run preview --workspace=@threejs-worlds/cosmos --",
    "preview:heian": "npm run preview --workspace=@threejs-worlds/heian --",
    "preview:shibuya": "npm run preview --workspace=@threejs-worlds/shibuya --",
    "preview:akihabara": "npm run preview --workspace=@threejs-worlds/akihabara --",
    "preview:shinjuku": "npm run preview --workspace=@threejs-worlds/shinjuku --"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": { "vite": "^8.3.1" }
}
